modules = ["go-1.21", "nodejs-20", "web", "bash", "lua-5.2", "go-1.25", "bun-1.3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 5002
externalPort = 3003

[[ports]]
localPort = 5678
externalPort = 3000

[[ports]]
localPort = 5679
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "PORT=5000 ./new-api"]
build = ["bash", "-c", "cd web && bun install && DISABLE_ESLINT_PLUGIN=true bun run build && cd .. && go build -o new-api ."]
